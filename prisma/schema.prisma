// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator fabbrica {
  provider    = "prisma-fabbrica"
  output      = "../generated/fabbrica"
  noTranspile = true
}

datasource db {
  provider = "postgresql"
}

// For reference
model Post {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  posts         Post[]
  properties    Property[]
  items         Item[]

  @@unique([email])
  @@map("users")
}

// Better Auth
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("sessions")
}

// Better Auth
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

// Better Auth
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verifications")
}

// Inventory management tables

model Item {
  id               Int     @id @default(autoincrement())
  requiresCheckout Boolean @default(false)
  maxCheckoutDays  Int?
  totalQty         Int?
  notifyThreshold  Int?

  // Audit
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  editedAt    DateTime @updatedAt

  // Relations
  properties Property[]

  @@index([createdById])
  @@index([requiresCheckout]) // Filtering checkout required items
  @@index([totalQty]) // Low qty sorting/reports
  @@index([createdAt]) // Recently added
  @@map("items")
}

enum PropertyType {
  NAME
  CATEGORY
  TAG
  LOCATION
}

model Property {
  id      Int          @id @default(autoincrement())
  type    PropertyType
  title   String
  content String?
  aliases String[]     @default([])
  data    Json?

  // Audit
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  editedAt    DateTime @updatedAt

  // Relations
  items Item[]

  @@index([createdById])
  @@index([type])
  @@index([title]) // Standalone title search/lookup
  @@index([aliases], type: Gin) // Array search
  @@map("properties")
}
